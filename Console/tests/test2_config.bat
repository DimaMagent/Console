@echo off
chcp 65001 > nul
setlocal

set EXE=Console.exe

:: Проверка наличия скомпилированного файла
if not exist %EXE% (
    echo [ERROR] Исполняемый файл %EXE% не найден!
    echo Сначала скомпилируйте проект.
    exit /b 1
)

echo ===================================================
echo   ТЕСТИРОВАНИЕ КОНФИГУРАЦИИ ЭМУЛЯТОРА (ЭТАП 2)
echo ===================================================
echo.

echo 1. Полные флаги (--vfs и --script):
%EXE% --vfs vfs.xml --script startup.txt
echo.
echo ---------------------------------------------------

echo 2. Короткие флаги (-v и -s):
%EXE% -v vfs.xml -s startup.txt
echo.
echo ---------------------------------------------------

echo 3. Запуск только с VFS (без стартового скрипта):
%EXE% --vfs vfs.xml
echo.
echo ---------------------------------------------------

echo 4. Тест ошибки: отсутствие обязательного параметра --vfs:
%EXE% --script startup.txt
echo.
echo ---------------------------------------------------

echo 5. Тест ошибки: неизвестный флаг:
%EXE% --vfs vfs.xml --unknown-flag
echo.
echo ---------------------------------------------------

echo 6. Вызов справки (--help):
%EXE% --help
echo.
echo ===================================================
echo   ТЕСТИРОВАНИЕ ЗАВЕРШЕНО
echo ===================================================

pause