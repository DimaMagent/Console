@echo off
chcp 65001 > nul
setlocal

:: Переходим в директорию, где находится сам .bat файл
cd /d "%~dp0"

set EXE=Console.exe

:: Проверка наличия скомпилированного файла
if not exist %EXE% (
    echo [ERROR] Исполняемый файл %EXE% не найден в %CD%!
    echo Сначала скомпилируйте проект: cl /EHsc /std:c++17 main.cpp
    pause
    exit /b 1
)

echo ===================================================
echo   ТЕСТИРОВАНИЕ ОСНОВНЫХ КОМАНД ЭМУЛЯТОРА (ЭТАП 4)
echo ===================================================
echo.

echo 1. Автоматическое тестирование через стартовый скрипт:
echo ---------------------------------------------------
%EXE% --vfs vfs.xml --script startup.txt

echo.
echo ---------------------------------------------------
echo 2. Тестирование с использованием коротких флагов):
echo ---------------------------------------------------
%EXE% -v vfs.xml -s startup.txt

echo.
echo ===================================================
echo   ТЕСТИРОВАНИЕ ЗАВЕРШЕНО
echo ===================================================

pause