@echo off
chcp 65001 > nul
setlocal

cd /d "%~dp0"

set EXE=Console.exe

if not exist %EXE% (
    echo [ERROR] Исполняемый файл %EXE% не найден в %CD%!
    echo Сначала скомпилируйте проект: cl /EHsc /std:c++17 main.cpp
    pause
    exit /b 1
)

echo ===================================================
echo   ТЕСТИРОВАНИЕ ВСЕХ КОМАНД ЭМУЛЯТОРА (ЭТАП 5)
echo ===================================================
echo.

echo 1. Тестирование с полными флагами:
echo ---------------------------------------------------
%EXE% --vfs vfs.xml --script startup.txt

echo.
echo ---------------------------------------------------
echo 2. Тестирование с короткими флагами:
echo ---------------------------------------------------
%EXE% -v vfs.xml -s startup.txt

echo.
===================================================
echo   ТЕСТИРОВАНИЕ ЗАВЕРШЕНО
===================================================

pause